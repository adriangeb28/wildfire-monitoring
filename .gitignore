# ----- Secrets -----
.env
*.key
secrets/

# ----- Raw data (landing zone) -----
# Keep the folder, ignore the contents. Small samples live in workshop_1/samples/
data/raw/*
data/reference/*
!data/raw/.gitkeep

# Large satellite / raster artefacts are never committed
*.tif
*.tiff
*.hdf
*.hdf5
*.nc
*.shp
*.shx
*.dbf
*.prj

# ----- Local package workaround (see tools/bootstrap_vendor.py) -----
vendor/
wheels/
.pip-tmp/
pip-*/

# ----- Python -----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ----- Editors / OS -----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ----- Outputs that can be regenerated -----
*.log
/tmp/
.cache/

!data/reference/.gitkeep


# ----- LaTeX build artifacts -----
*.aux
*.log
*.toc
*.out
*.synctex.gz

# ----- PDF build intermediates -----
docs/build_pdf/
