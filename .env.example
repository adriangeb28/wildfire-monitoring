# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed.

# --- NASA FIRMS -------------------------------------------------------------
# Free MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Used by the incremental NRT source (F3). Limit: 5000 transactions / 10 min.
FIRMS_MAP_KEY=your_map_key_here

# --- NASA Earthdata ---------------------------------------------------------
# Needed by the FIRMS Archive Download web service (F1).
# Register: https://urs.earthdata.nasa.gov/users/new
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password

# --- Open-Meteo -------------------------------------------------------------
# No key required. Free tier is for non-commercial use only,
# limit: 10000 calls/day, 5000/hour, 600/minute.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1

# --- Project settings -------------------------------------------------------
# Geographic scope used by the ingestion code (west,south,east,north).
FIRE_BBOX=-79.0,-4.5,-66.5,13.5
# Timezone for all stored timestamps. Do not change.
FIRE_TIMEZONE=UTC
# Database connection used by the storage layer (optional at workshop stage).
DATABASE_URL=postgresql://user:password@localhost:5432/fires
